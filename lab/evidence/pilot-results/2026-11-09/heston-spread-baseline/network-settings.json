  "actual_source_excerpts": {
    "build_workflow": {
      "path": "/Users/afengler/Projects/proj_sbi4finance/sbi4finance-heston-spread-baseline-20261109/lab/scripts/train_heston_spread_baseline.py",
      "first_line": 124,
      "source": "def build_workflow(task, schedule_updates=10000):\n    \"\"\"Public BF2.1 spline workflow; no generating c or tau conditioning.\"\"\"\n    validate_task(task)\n    import bayesflow as bf\n    import keras\n    if bf.__version__ != \"2.1.0\" or keras.backend.backend() != \"jax\":\n        raise RuntimeError(\"use the locked BayesFlow 2.1.0 JAX core environment\")\n    adapter = bf.Adapter()\n    names = task[\"target\"][\"parameter_names\"]\n    for name, (lo, hi) in zip(names, task[\"target\"][\"prior_bounds\"], strict=True):\n        adapter = adapter.constrain(name, lower=float(lo), upper=float(hi), inclusive=\"none\")\n    adapter = (adapter.convert_dtype(\"float64\", \"float32\")\n               .concatenate(names, into=\"inference_variables\")\n               .concatenate([\"observations\"], into=\"inference_conditions\"))\n    optimizer = keras.optimizers.Adam(keras.optimizers.schedules.CosineDecay(\n        initial_learning_rate=5e-4, decay_steps=schedule_updates, alpha=.1))\n    flow = bf.networks.CouplingFlow(transform=\"spline\", subnet_kwargs={\"widths\": [128, 128], \"dropout\": .05})\n    workflow = bf.BasicWorkflow(adapter=adapter, inference_network=flow,\n                               standardize=[\"inference_variables\", \"inference_conditions\"], optimizer=optimizer)\n    workflow.estimator.compile(optimizer=optimizer, steps_per_execution=1)\n    return workflow"
    },
    "switch_existing_dropout_layers_to_zero": {
      "path": "/Users/afengler/Projects/proj_sbi4finance/sbi4finance-heston-spread-baseline-20261109/lab/scripts/train_heston_spread_baseline.py",
      "first_line": 259,
      "source": "def switch_dropout_zero(model, *, reloading=False):\n    \"\"\"Change only existing Dropout rates after original .05 initialization.\"\"\"\n    layers = dropout_layers(model)\n    rates = [float(layer.rate) for layer in layers]\n    if len(layers) != 24 or any(rate not in ((0., .05) if reloading else (.05,)) for rate in rates):\n        raise ValueError(\"zero-dropout control requires the frozen 24-layer .05 construction\")\n    before = state_summary(model, current_state(model))\n    for layer in layers:\n        layer.rate = 0.\n    after = state_summary(model, current_state(model))\n    if before != after:\n        raise RuntimeError(\"changing dropout rates changed learned/permutation/optimizer/standardizer/RNG arrays\")\n    return {\"method\": \"construct/build original .05 model, then change existing Dropout.rate to0 before the first update\",\n            \"rates_before\": rates, \"rates_after\": [float(layer.rate) for layer in layers],\n            \"array_state_unchanged\": True,\n            \"state_groups\": {name: {\"variable_count\": len(rows), \"before_sha256\": fingerprint(rows),\n                                    \"after_sha256\": fingerprint(after[name])} for name, rows in before.items()},\n            \"original_initial_full_hash_available\": False,\n            \"claim_limit\": \"exact within-replay before/after equality; original default run did not persist its full initial state\",\n            \"archive_scope\": \"network constructor remains .05; load_checkpoint reapplies recorded effective zero rates; exact training resume unsupported\"}"
    },
    "annealing_schedule": {
      "path": "/Users/afengler/Projects/proj_sbi4finance/sbi4finance-heston-spread-baseline-20261109/lab/scripts/anneal_heston_spread_baseline.py",
      "first_line": 69,
      "source": "def make_schedule():\n    os.environ.setdefault(\"KERAS_BACKEND\", \"jax\")\n    import keras\n    return keras.optimizers.schedules.PiecewiseConstantDecay([BOUNDARY], list(RATES), name=\"heston_spread_two_stage_annealing\")"
    }
  },
