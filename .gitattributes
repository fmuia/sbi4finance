# Preserve raw scientific evidence while keeping review focused on code/reports.
# Accepted assets carry byte-level checksums. Git must not rewrite their line
# endings on checkout (notably when core.autocrlf=true on Windows).
tutorial/assets/** -text

lab/evidence/pilot-results/**/*.json linguist-generated=true
lab/evidence/pilot-results/**/*.npz linguist-generated=true
lab/evidence/pilot-results/**/*.png linguist-generated=true
lab/evidence/pilot-results/**/*.svg linguist-generated=true
lab/evidence/pilot-results/**/*.psv linguist-generated=true
tutorial/assets/trajectories/** linguist-generated=true
tutorial/assets/results/trajectories/** linguist-generated=true
lab/evidence/path-inference/**/*.json linguist-generated=true

# Matplotlib SVG path lines include trailing separators; preserve generated bytes.
lab/evidence/illustrations/**/*.svg linguist-generated=true whitespace=-blank-at-eol
